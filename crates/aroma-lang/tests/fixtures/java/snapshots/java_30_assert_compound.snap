---
source: crates/aroma-lang/tests/java_adapter.rs
---
unit 0
compat:  ["{####}", "{", ["assert#:#;", "assert", ["#!=#", {$"factor"}, "!=", {"0"}], ":", {"\"factor\""}, ";"], ["#;", ["#*=#", {$"x"}, "*=", {$"factor"}], ";"], ["#;", ["#-=#", {$"x"}, "-=", {"1"}], ";"], ["return#;", "return", ["#%#", {$"x"}, "%", {"7"}], ";"], "}"]
default: ["{####}", "{", ["assert#:#;", "assert", ["#!=#", {$"factor"}, "!=", {"0"}], ":", {"\"factor\""}, ";"], ["#;", ["#*=#", {$"x"}, "*=", {$"factor"}], ";"], ["#;", ["#-=#", {$"x"}, "-=", {"1"}], ";"], ["return#;", "return", ["#%#", {$"x"}, "%", {"7"}], ";"], "}"]
features:
  "factor" ["#VAR","#!=#1>#VAR","assert#:#;2>#VAR","#VAR>>0","#!=#1>>>#*=#3"]
  "0" ["0","#!=#3>0","assert#:#;2>0","#VAR>>0","0>>\"factor\""]
  "\"factor\"" ["\"factor\"","assert#:#;4>\"factor\"","0>>\"factor\"","\"factor\">>#VAR"]
  "x" ["#VAR","#*=#1>#VAR","#;1>#VAR","\"factor\">>#VAR","#VAR>>#VAR","#*=#1>>>#-=#1","#*=#1>>>#%#1"]
  "factor" ["#VAR","#*=#3>#VAR","#;1>#VAR","#!=#1>>>#*=#3","#VAR>>#VAR","#VAR>>#VAR"]
  "x" ["#VAR","#-=#1>#VAR","#;1>#VAR","#*=#1>>>#-=#1","#VAR>>#VAR","#VAR>>1","#-=#1>>>#%#1"]
  "1" ["1","#-=#3>1","#;1>1","#VAR>>1","1>>#VAR"]
  "x" ["#VAR","#%#1>#VAR","return#;2>#VAR","#-=#1>>>#%#1","#*=#1>>>#%#1","1>>#VAR","#VAR>>7"]
  "7" ["7","#%#3>7","return#;2>7","#VAR>>7"]
