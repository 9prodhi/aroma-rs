---
source: crates/aroma-lang/tests/java_adapter.rs
---
unit 0
compat:  ["{####}", "{", ["#;", ["#++", {$"i"}, "++"], ";"], ["#;", ["--#", "--", {$"j"}], ";"], ["#;", ["int#", "int", ["#=#", {$"k"}, "=", ["#+#", ["-#", "-", {$"i"}], "+", ["~#", "~", {$"j"}]]]], ";"], ["#;", ["#=#", {$"b"}, "=", ["!#", "!", {$"b"}]], ";"], "}"]
default: ["{####}", "{", ["#;", ["#++", {$"i"}, "++"], ";"], ["#;", ["--#", "--", {$"j"}], ";"], ["#;", ["int#", "int", ["#=#", {$"k"#0}, "=", ["#+#", ["-#", "-", {$"i"}], "+", ["~#", "~", {$"j"}]]]], ";"], ["#;", ["#=#", {$"b"}, "=", ["!#", "!", {$"b"}]], ";"], "}"]
features:
  "i" ["#VAR","#++1>#VAR","#;1>#VAR","#VAR>>#VAR","#++1>>>-#2"]
  "j" ["#VAR","--#2>#VAR","#;1>#VAR","#VAR>>#VAR","#VAR>>#VAR","--#2>>>~#2"]
  "k" ["#VAR","#=#1>#VAR","int#2>#VAR","#;1>#VAR","#VAR>>#VAR","#VAR>>#VAR"]
  "i" ["#VAR","-#2>#VAR","#+#1>#VAR","#=#3>#VAR","#++1>>>-#2","#VAR>>#VAR","#VAR>>#VAR"]
  "j" ["#VAR","~#2>#VAR","#+#3>#VAR","#=#3>#VAR","--#2>>>~#2","#VAR>>#VAR","#VAR>>#VAR"]
  "b" ["#VAR","#=#1>#VAR","#;1>#VAR","#VAR>>#VAR","#=#1>>>!#2","#VAR>>#VAR"]
  "b" ["#VAR","!#2>#VAR","#=#3>#VAR","#;1>#VAR","#=#1>>>!#2","#VAR>>#VAR"]
